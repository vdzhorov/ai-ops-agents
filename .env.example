# Copy to .env (git-ignored) and fill in.
ANTHROPIC_API_KEY=

# Claude model for the final assessment. Default: claude-opus-5-5 (best judgement).
# claude-haiku-5-5 is ~40x cheaper per token if cost matters more than depth.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high -- reasoning depth per request (low keeps token spend down)
ANTHROPIC_EFFORT=low

# Local model via Ollama (triage in hybrid mode)
OLLAMA_HOST_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Language of explanations in the report: bg | en
AIOPS_LANG=bg

# Optional: GitHub token for the changelog tool (60 -> 5000 API requests/hour). No scopes needed.
GITHUB_TOKEN=
